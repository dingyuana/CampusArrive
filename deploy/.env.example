# =============================================================================
# 微迎新 CampusArrive — 环境变量模板
# 用法：cp .env.example .env  然后填入真实值（请勿提交 .env 到版本库）
# 所有密钥仅在此处集中管理，docker-compose 通过 env_file 注入，禁止硬编码到镜像。
# =============================================================================

# -----------------------------------------------------------------------------
# 通用
# -----------------------------------------------------------------------------
# 运行环境：sit | uat | perf
SPRING_PROFILES_ACTIVE=sit

# -----------------------------------------------------------------------------
# MySQL 8.0 配置
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=ChangeMeRoot#2024
MYSQL_DATABASE=campus_arrive
MYSQL_USER=campus_app
MYSQL_PASSWORD=ChangeMeApp#2024

# -----------------------------------------------------------------------------
# Redis 7 配置
# -----------------------------------------------------------------------------
REDIS_PASSWORD=ChangeMeRedis#2024

# -----------------------------------------------------------------------------
# RabbitMQ 3.13 配置
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=campus
RABBITMQ_DEFAULT_PASS=ChangeMeMq#2024
RABBITMQ_DEFAULT_VHOST=/

# -----------------------------------------------------------------------------
# JWT 鉴权（网关签发、各服务校验，务必保持各服务一致）
# -----------------------------------------------------------------------------
JWT_SECRET=ChangeMeJwtSecret-Replace-With-256bit-Random-String-0123456789
JWT_EXPIRATION=86400000

# -----------------------------------------------------------------------------
# MaxKB 配置（INFRA-1.3：ai-service 调用 MaxKB 知识库 API）
# -----------------------------------------------------------------------------
MAXKB_VERSION=v1.10.7-lts
MAXKB_PORT=8088
MAXKB_ADMIN_USER=admin
MAXKB_ADMIN_PASSWORD=MaxKB@123..
MAXKB_SECRET_KEY=ChangeMe-MaxKB-Secret-Key-32chars-Min
MAXKB_BASE_URL=http://maxkb:8080
MAXKB_API_KEY=ChangeMe-MaxKB-Application-API-Key

# MaxKB 内置 PostgreSQL/pgvector 数据库（docker-compose.maxkb.yml 使用）
MAXKB_DB_NAME=maxkb
MAXKB_DB_USER=maxkb
MAXKB_DB_PASSWORD=ChangeMeMaxKbDb#2024

# -----------------------------------------------------------------------------
# DeepSeek LLM（作为 MaxKB 后端模型，或 ai-service 直连兜底）
#   DEEPSEEK_API_KEY 占位，正式值在 MaxKB 控制台或 ai-service 注入
#   申请地址：https://platform.deepseek.com/api_keys
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-Replace-With-Your-DeepSeek-API-Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# -----------------------------------------------------------------------------
# 服务端口（容器内端口固定，宿主机映射在 compose / 环境覆盖文件中调整）
#   gateway            8080 -> 对外暴露
#   checkin-service     8081 -> 仅内部
#   ai-service          8082 -> 仅内部
#   parent-service      8083 -> 仅内部
#   integration-service 8084 -> 仅内部
#   rabbitmq mgmt       15672 -> 127.0.0.1 绑定
#   maxkb               8088  -> 对外暴露
#   debezium connect    8083  -> 管理端口
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Kafka / Debezium（可选，仅 docker-compose.debezium.yml 启用时需要）
# -----------------------------------------------------------------------------
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# DEBEZIUM_CONNECT_HOST=debezium-connect:8083
